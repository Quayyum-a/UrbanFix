# Copy to .env and fill in. Find both values in Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: WhatsApp number for "Forgot PIN?" (international format, e.g. 2348012345678)
EXPO_PUBLIC_SUPPORT_WHATSAPP=
